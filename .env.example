# Copy to .env.local. infra/bootstrap.sh prints correct values for all of these.

AWS_REGION=us-east-1
IDP_BUCKET=idp-documents-<account-id>-us-east-1
IDP_TABLE=idp-documents

# Bedrock is not enabled in every region; set independently if needed.
BEDROCK_REGION=us-east-1

# Bedrock prefixes Anthropic model ids with "anthropic.".
# Opus 5 is the default. Swap to a cheaper tier for high-volume experiments.
# BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Fields scoring below this route to a human. The main accuracy/cost dial.
# CONFIDENCE_THRESHOLD=0.85

# Credentials come from the default AWS chain (env, ~/.aws/credentials, SSO).
# Do not put access keys in this file.
