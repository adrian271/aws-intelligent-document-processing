# Copy to .env.local. infra/bootstrap.sh prints correct values for all of these.

AWS_REGION=us-east-1
IDP_BUCKET=idp-documents-<account-id>-us-east-1
IDP_TABLE=idp-documents

# Bedrock is not enabled in every region; set independently if needed.
BEDROCK_REGION=us-east-1

# Which model does classification + extraction. The backend is chosen from
# this id alone (see src/lib/providers.ts):
#   anthropic.*  -> Messages API, native structured outputs
#   anything else-> Converse API with a forced tool call (Nova, Llama, Mistral)
#
# Anthropic models on Bedrock require a one-time use-case form (README).
# Amazon Nova needs no form, so it is the fastest way to get running.
# BEDROCK_MODEL_ID=anthropic.claude-opus-5
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Fields scoring below this route to a human. The main accuracy/cost dial.
# CONFIDENCE_THRESHOLD=0.85

# Credentials come from the default AWS chain (env, ~/.aws/credentials, SSO).
# Do not put access keys in this file.
